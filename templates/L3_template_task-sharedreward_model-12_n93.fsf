set feat_files(1) "/ZPOOL/data/projects/rf1-sra-sharedreward/derivatives/fsl/sub-10317/L2_task-sharedreward_model-1_REPLACEME_sm-6.gfeat/copeCOPENUM.feat/stats/cope1.nii.gz"

